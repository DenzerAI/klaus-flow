<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.denzer.klaus</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/Applications/Klaus.app/Contents/MacOS/klaus-flow</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.klaus-flow/logs/klaus-flow.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.klaus-flow/logs/klaus-flow.stderr.log</string>
</dict>
</plist>
